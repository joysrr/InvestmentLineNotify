{
  "name": "line-etf-notify",
  "version": "2.0.0",
  "main": "netlify/functions/pushLine.cjs",
  "scripts": {
    "start": "node src/runDailyCheck.mjs",
    "dev:no-ai": "node src/runDailyCheck.mjs --no-ai --no-telegram",
    "dev:force": "node src/runDailyCheck.mjs --force-notify",
    "bot": "node src/bot.mjs",
    "api": "node src/api/server.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:data": "vitest run src/test/integration/dataIntegrity.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify:data-evidence": "node scripts/generate-data-evidence-report.mjs",
    "sync:production-artifacts": "node scripts/sync-production-artifacts.mjs",
    "verify": "npm run lint && npm test && npm run openapi:check",
    "pre-deploy": "npm run verify && npm --prefix webapp run lint && npm --prefix webapp run test && npm --prefix webapp run test:e2e",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/check-openapi-diff.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@google/genai": "^1.38.0",
    "@langfuse/client": "^5.11.0",
    "@langfuse/core": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.3.1",
    "fastify": "^5.3.2",
    "google-auth-library": "^10.5.0",
    "google-spreadsheet": "^5.0.2",
    "grammy": "^1.42.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.6",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "puppeteer": "^25.4.0"
  },
  "lint-staged": {
    "*.{js,mjs}": "eslint --fix",
    "*.{js,mjs,json,md}": "prettier --write"
  }
}
