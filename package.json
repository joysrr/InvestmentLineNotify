{
  "name": "line-etf-notify",
  "version": "2.0.0",
  "main": "netlify/functions/pushLine.cjs",
  "scripts": {
    "start": "node src/runDailyCheck.mjs",
    "dev:no-ai": "node src/runDailyCheck.mjs --no-ai --no-telegram",
    "dev:force": "node src/runDailyCheck.mjs --force-notify",
    "bot": "node src/bot.mjs",
    "api": "node src/api/server.mjs",
    "prepare": "husky",
    "test": "vitest run --dir src/test",
    "test:data": "vitest run src/test/integration/dataIntegrity.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "node scripts/verify-all.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^1.38.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.3.2",
    "google-auth-library": "^10.5.0",
    "google-spreadsheet": "^5.0.2",
    "grammy": "^1.42.0",
    "langfuse": "^3.38.6",
    "pino": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,mjs}": "eslint --fix",
    "*.{js,mjs,json,md}": "prettier --write"
  }
}
