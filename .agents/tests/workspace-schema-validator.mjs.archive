#!/usr/bin/env node
// workspace-schema-validator.mjs
// 驗證 WORKSPACE_SCHEMA.yaml 與當前 active workspace 的欄位對齊性
// 依 PROPOSAL_20260422_022 Phase E 建立
// 使用：node .agents/tests/workspace-schema-validator.mjs [--workspace <name>] [--strict]
//
// 退出碼：
//   0 = 通過
//   1 = 警告（required 齊全、僅 optional 缺失 / Markdown 標題不對齊）
//   2 = 錯誤（required 欄位缺失 / SCHEMA 無法解析 / workspace 不存在）

import { readFileSync, existsSync, readdirSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const AGENTS_ROOT = join(__dirname, '..');
const SCHEMA_PATH = join(AGENTS_ROOT, 'WORKSPACE_SCHEMA.yaml');
const CURRENT_WORKSPACE_PATH = join(AGENTS_ROOT, 'CURRENT_WORKSPACE');
const WORKSPACES_DIR = join(AGENTS_ROOT, 'workspaces');
const SKILLS_DIR = join(AGENTS_ROOT, 'skills');
const TASKS_DIR = join(AGENTS_ROOT, 'tasks');

// -------- CLI args --------
const args = process.argv.slice(2);
let targetWorkspace = null;
let strict = false;
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--workspace' && args[i + 1]) { targetWorkspace = args[++i]; }
  else if (args[i] === '--strict') { strict = true; }
}

let errors = 0;
let warnings = 0;

function err(msg) { console.error(`❌ [ERROR] ${msg}`); errors++; }
function warn(msg) { console.warn(`⚠️  [WARN]  ${msg}`); warnings++; }
function info(msg) { console.log(`ℹ️  ${msg}`); }

// -------- Minimal YAML parser (for this schema's limited syntax) --------
// 支援 flow-style（{ key: value, ... }）與 block-style（indentation）
// 不依賴 node_modules；schema 為自控格式，已驗證可解析
function parseYaml(text) {
  const root = {};
  const stack = [{ indent: -1, obj: root }];
  const lines = text.split('\n');

  for (let rawLine of lines) {
    // 移除完整註解行
    const line = rawLine.replace(/\r$/, '');
    if (!line.trim() || /^\s*#/.test(line)) continue;

    const indent = line.match(/^(\s*)/)[1].length;
    const stripped = line.trim();

    // 找到對應層級的父節點
    while (stack.length > 1 && stack[stack.length - 1].indent >= indent) stack.pop();
    const parent = stack[stack.length - 1].obj;

    // key: value 形式
    const kvMatch = stripped.match(/^([A-Za-z_][\w]*)\s*:\s*(.*)$/);
    if (kvMatch) {
      const key = kvMatch[1];
      let rest = kvMatch[2].replace(/\s*#.*$/, '').trim(); // 移除行內註解

      if (rest === '') {
        // block-style，子節點尚未出現
        parent[key] = {};
        stack.push({ indent, obj: parent[key] });
      } else if (rest.startsWith('{') && rest.endsWith('}')) {
        // flow-style object: { type: string, required: true, ... }
        const inner = rest.slice(1, -1);
        const obj = {};
        // 簡化解析：以 逗號 分隔，但逗號若位於 [ ] 內須保留
        const parts = splitTopLevel(inner, ',');
        for (const p of parts) {
          const m = p.match(/^\s*([A-Za-z_][\w]*)\s*:\s*(.+?)\s*$/);
          if (!m) continue;
          obj[m[1]] = parseScalar(m[2]);
        }
        parent[key] = obj;
      } else {
        parent[key] = parseScalar(rest);
      }
    }
  }
  return root;
}

function splitTopLevel(str, sep) {
  const out = []; let buf = ''; let depth = 0;
  for (const c of str) {
    if (c === '[' || c === '{') depth++;
    if (c === ']' || c === '}') depth--;
    if (c === sep && depth === 0) { out.push(buf); buf = ''; }
    else buf += c;
  }
  if (buf.trim()) out.push(buf);
  return out;
}

function parseScalar(s) {
  s = s.trim();
  if (s === 'true') return true;
  if (s === 'false') return false;
  if (s === 'null' || s === '') return null;
  if (/^-?\d+(\.\d+)?$/.test(s)) return Number(s);
  if (s.startsWith('"') && s.endsWith('"')) return s.slice(1, -1);
  if (s.startsWith("'") && s.endsWith("'")) return s.slice(1, -1);
  if (s.startsWith('[') && s.endsWith(']')) {
    return splitTopLevel(s.slice(1, -1), ',').map(x => parseScalar(x));
  }
  return s;
}

// -------- Extract field definitions from parsed schema --------
// 回傳 { 'PROJECT_CONTEXT.project_name': { type, required, referenced_by }, ... }
function flattenSchema(schema, prefix = '') {
  const out = {};
  for (const [k, v] of Object.entries(schema)) {
    if (k === 'schema_version' || k === 'last_modified' || k === 'last_proposal') continue;
    const path = prefix ? `${prefix}.${k}` : k;
    if (v && typeof v === 'object' && 'type' in v) {
      // field definition
      out[path] = v;
    } else if (v && typeof v === 'object') {
      Object.assign(out, flattenSchema(v, path));
    }
  }
  return out;
}

// -------- Workspace markdown 檢查（heuristic：檢查 H2 / H3 標題存在性）--------
function checkWorkspaceHasSection(mdContent, sectionTitle) {
  const re = new RegExp(`^##+\\s*${escapeRegExp(sectionTitle)}`, 'm');
  return re.test(mdContent);
}

function escapeRegExp(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// -------- F2 skills/tasks 驗證（依 PROPOSAL_20260423_001）--------
// 掃描 .agents/skills/*.md + .agents/tasks/*.md
// 檢查 F2 類 MACHINE_READABLE anchor + §專案特化參照 完整性 + 欄位 cross-reference
function validateSkillsAndTasks(topLevelKeys) {
  const dirs = [
    { path: SKILLS_DIR, label: 'skill' },
    { path: TASKS_DIR, label: 'task' }
  ];

  // 允許的 workspace 欄位前綴：top-level schema keys + meta 引用
  const allowedPrefixes = new Set([...topLevelKeys, 'WORKSPACE_SCHEMA', 'CURRENT_WORKSPACE']);

  let scanned = 0;
  let f2Count = 0;

  for (const { path: dir, label } of dirs) {
    if (!existsSync(dir)) continue;
    const files = readdirSync(dir).filter(f => f.endsWith('.md'));

    for (const f of files) {
      scanned++;
      const filePath = join(dir, f);
      const content = readFileSync(filePath, 'utf-8');

      const mrMatch = content.match(/<!--\s*MACHINE_READABLE\s*([\s\S]*?)-->/);
      const hasReferencesSection = /##\s+🔗?\s*專案特化參照/.test(content);

      let category = null;
      let anchorType = null;
      if (mrMatch) {
        const anchor = mrMatch[1];
        const typeMatch = anchor.match(/type:\s*([a-z-]+)/);
        const categoryMatch = anchor.match(/category:\s*(F[123])/);
        anchorType = typeMatch ? typeMatch[1] : null;
        if (anchorType === 'project-specific-references') {
          category = categoryMatch ? categoryMatch[1] : null;
        }
      }

      if (category === 'F2') {
        f2Count++;
        if (!hasReferencesSection) {
          err(`F2 ${label} missing §專案特化參照 section: ${f}`);
          continue;
        }
        // Cross-reference: 擷取表格第二欄提到的 workspace 欄位前綴（top-level key）
        const refBlockMatch = content.match(/##\s+🔗[\s\S]*$/);
        if (refBlockMatch) {
          const block = refBlockMatch[0];
          // 比對 `<KEY>` 格式（允許 `DEPLOYMENT_CONSTRAINTS.memory` 或單獨 `BUSINESS_RULES`）
          const refs = [...block.matchAll(/`([A-Z][A-Z_]+)(?:\.[\w.*]+)?`/g)];
          const unique = [...new Set(refs.map(m => m[1]))];
          for (const key of unique) {
            if (!allowedPrefixes.has(key)) {
              warn(`F2 ${label} ${f}: referenced workspace key "${key}" not in WORKSPACE_SCHEMA top-level`);
            }
          }
        }
      } else if (category === 'F3') {
        err(`F3 category 禁止於 .agents/skills/ 或 .agents/tasks/（應入 workspace 實值欄位）: ${f}`);
      } else if (!category && hasReferencesSection) {
        warn(`${label} ${f}: has §專案特化參照 but missing F2 MACHINE_READABLE anchor (F1 類勿用此區塊；F2 類請補 anchor)`);
      }
    }
  }

  info(`Scanned ${scanned} skills/tasks files; F2 identified: ${f2Count}`);
}

// -------- Main --------
function main() {
  if (!existsSync(SCHEMA_PATH)) { err(`SCHEMA not found: ${SCHEMA_PATH}`); process.exit(2); }

  const schemaText = readFileSync(SCHEMA_PATH, 'utf-8');
  let schema;
  try { schema = parseYaml(schemaText); } catch (e) { err(`YAML parse failed: ${e.message}`); process.exit(2); }

  info(`Schema version: ${schema.schema_version || '<unknown>'}`);

  const fields = flattenSchema(schema);
  const requiredFields = Object.entries(fields).filter(([, v]) => v.required === true).map(([k]) => k);
  info(`Total fields: ${Object.keys(fields).length}; Required: ${requiredFields.length}`);

  // PROPOSAL_20260424_019 F-3：interactive / auto_populate 合法性檢查（schema v1.4+）
  const VALID_AUTO_SOURCES = new Set(['system', 'default', 'derive_from_stacks']);
  for (const [path, def] of Object.entries(fields)) {
    if (def.interactive === false) {
      if (!def.auto_populate || typeof def.auto_populate !== 'object') {
        err(`schema field "${path}" has interactive:false but missing auto_populate block`);
        continue;
      }
      const src = def.auto_populate.source;
      if (!VALID_AUTO_SOURCES.has(src)) {
        err(`schema field "${path}" auto_populate.source "${src}" not in [system, default, derive_from_stacks]`);
      }
      if (src === 'system' && def.auto_populate.value !== 'today') {
        warn(`schema field "${path}" auto_populate.source=system；目前僅支援 value: today`);
      }
    }
    if (def.auto_populate && def.interactive !== false) {
      warn(`schema field "${path}" has auto_populate but interactive not set to false（auto_populate 不會被套用）`);
    }
  }

  // 擷取 top-level schema keys（供 F2 cross-reference 驗證）
  const topLevelKeys = Object.keys(schema).filter(k => !['schema_version', 'last_modified', 'last_proposal'].includes(k));

  // F2 skills/tasks 驗證（依 PROPOSAL_20260423_001）
  validateSkillsAndTasks(topLevelKeys);

  // 決定目標 workspace
  if (!targetWorkspace) {
    if (existsSync(CURRENT_WORKSPACE_PATH)) {
      targetWorkspace = readFileSync(CURRENT_WORKSPACE_PATH, 'utf-8').trim();
    }
  }
  if (!targetWorkspace || targetWorkspace === 'default_env') {
    warn(`No active workspace set (CURRENT_WORKSPACE = "${targetWorkspace || '<empty>'}"); skip workspace field validation`);
    summary(); return;
  }

  const workspaceFile = join(WORKSPACES_DIR, `${targetWorkspace}.md`);
  if (!existsSync(workspaceFile)) { err(`Workspace file not found: ${workspaceFile}`); summary(); return; }

  const mdContent = readFileSync(workspaceFile, 'utf-8');

  // 檢查 top-level sections（SCHEMA 頂層 key → workspace H2 ## <KEY>）
  // SCHEMA 頂層 key 即為 workspace section title（topLevelKeys 已於上方宣告）
  for (const key of topLevelKeys) {
    const hasSection = checkWorkspaceHasSection(mdContent, key);
    if (!hasSection) {
      // 判斷 required 性：若該 section 底下有 required 欄位 → error；否則 warn
      const childRequired = requiredFields.some(f => f.startsWith(`${key}.`) || f === key);
      if (childRequired) err(`workspace missing required section: ${key}`);
      else warn(`workspace missing optional section: ${key}`);
    }
  }

  // 檢查 required 欄位的 key 出現在 workspace md（heuristic：bold key **project_name**: 或 - **project_name**）
  for (const reqKey of requiredFields) {
    const leafName = reqKey.split('.').pop();
    const re = new RegExp(`\\*\\*${escapeRegExp(leafName)}\\*\\*\\s*[:：]`, 'm');
    if (!re.test(mdContent)) {
      err(`workspace "${targetWorkspace}" missing required field: ${reqKey} (leaf: ${leafName})`);
    }
  }

  summary();
}

function summary() {
  console.log('');
  console.log(`Summary: errors=${errors}, warnings=${warnings}`);
  if (errors > 0) process.exit(2);
  if (warnings > 0 && strict) process.exit(1);
  if (warnings > 0) process.exit(1);
  process.exit(0);
}

main();
