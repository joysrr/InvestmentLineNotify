#!/usr/bin/env node
// iron-theme-validator.mjs
// 驗證 iron-rules/ 跨切不可變鐵律一致性
// 由 PROPOSAL_20260501_002 Phase E + ADR-0037 建立
//
// 雙向一致性檢查：
//   1. 每 theme `applies_to` 列出的 agent 必有對應 rule，且 rule frontmatter `applies_iron_themes` 包含本 theme
//   2. 每 rule `applies_iron_themes` 列出的 theme 必存在於 iron-rules/，且 theme `applies_to` 包含本 agent
//
// 退出碼：
//   0 = 全 PASS
//   1 = warn（一致性 drift；不阻斷 commit）
//   2 = error（缺檔 / schema 不符）

import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseFrontmatter } from './lib/frontmatter.mjs';

const __dirname = dirname(fileURLToPath(import.meta.url));
const AGENTS_ROOT = join(__dirname, '..');
const RULES_DIR = join(AGENTS_ROOT, 'rules');
const IRON_RULES_DIR = join(AGENTS_ROOT, 'iron-rules');

let errors = 0;
let warnings = 0;

function err(msg) { console.error(`❌ [ERROR] ${msg}`); errors++; }
function warn(msg) { console.warn(`⚠️  [WARN]  ${msg}`); warnings++; }
function info(msg) { console.log(`ℹ️  ${msg}`); }

function parseListField(fm, key) {
  // YAML list parsing for simple frontmatter parser
  // Handles inline `[a, b, c]` or null
  if (!fm[key]) return [];
  const v = fm[key];
  if (typeof v === 'string') {
    // strip brackets if present
    return v.replace(/^\[|\]$/g, '').split(',').map(x => x.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
  }
  return [];
}

function parseMultilineList(content, key) {
  // Parse YAML-style multi-line list:
  //   key:
  //     - item1
  //     - item2
  const re = new RegExp(`^${key}:\\s*\\n((?:\\s+-\\s+\\S.*\\n?)+)`, 'm');
  const m = content.match(re);
  if (!m) return [];
  return m[1].split('\n')
    .map(l => l.match(/^\s+-\s+(.+?)$/))
    .filter(Boolean)
    .map(m => m[1].trim().replace(/^["']|["']$/g, ''));
}

function loadRule(filePath) {
  const content = readFileSync(filePath, 'utf-8');
  const fm = parseFrontmatter(content) || {};
  const agentId = fm.agent_id;
  const themes = parseMultilineList(content, 'applies_iron_themes');
  return { path: filePath, agentId, themes, content };
}

function loadIronTheme(filePath) {
  const content = readFileSync(filePath, 'utf-8');
  const fm = parseFrontmatter(content) || {};
  const themeId = fm.theme_id;
  const fileType = fm.file_type;
  const immutable = fm.immutable === 'true' || fm.immutable === true;
  const appliesTo = parseMultilineList(content, 'applies_to');
  return { path: filePath, themeId, fileType, immutable, appliesTo, content };
}

console.log('🔍 Iron Theme Validator (PROPOSAL_20260501_002 + ADR-0037)\n');

// 1. Load all iron themes
if (!existsSync(IRON_RULES_DIR)) {
  err(`iron-rules/ 目錄不存在: ${IRON_RULES_DIR}`);
  process.exit(2);
}

const themeFiles = readdirSync(IRON_RULES_DIR)
  .filter(f => f.endsWith('.md') && f !== 'README.md')
  .map(f => join(IRON_RULES_DIR, f));

const themes = themeFiles.map(loadIronTheme);
info(`載入 ${themes.length} 個 iron themes`);

// 2. Validate each theme schema
for (const t of themes) {
  if (!t.themeId) err(`${t.path}: 缺 theme_id`);
  if (t.fileType !== 'iron_theme') err(`${t.path}: file_type 應為 iron_theme（實際: ${t.fileType}）`);
  if (!t.immutable) warn(`${t.path}: immutable 應為 true`);
  if (t.appliesTo.length === 0) err(`${t.path}: applies_to 為空（應列出引用 agent）`);
}

// 3. Load all rules
const ruleFiles = readdirSync(RULES_DIR)
  .filter(f => f.endsWith('.md'))
  .map(f => join(RULES_DIR, f));

const rules = ruleFiles.map(loadRule);
info(`載入 ${rules.length} 個 rules`);

// 4. Bidirectional consistency check
console.log('\n📋 雙向一致性檢查');

// 4a. Theme.applies_to → Rule.applies_iron_themes
for (const t of themes) {
  for (const agentId of t.appliesTo) {
    const rule = rules.find(r => r.agentId === agentId);
    if (!rule) {
      err(`Theme ${t.themeId} applies_to ${agentId}，但無對應 rules/${agentId}.md`);
      continue;
    }
    if (!rule.themes.includes(t.themeId)) {
      err(`Theme ${t.themeId} applies_to ${agentId}，但 rule ${rule.path} frontmatter applies_iron_themes 未列 ${t.themeId}`);
    }
  }
}

// 4b. Rule.applies_iron_themes → Theme.applies_to
for (const r of rules) {
  for (const themeId of r.themes) {
    const theme = themes.find(t => t.themeId === themeId);
    if (!theme) {
      err(`Rule ${r.path} 引用 iron theme ${themeId}，但 iron-rules/${themeId}.md 不存在`);
      continue;
    }
    if (!theme.appliesTo.includes(r.agentId)) {
      err(`Rule ${r.path} (agent_id=${r.agentId}) 引用 ${themeId}，但 theme applies_to 未列 ${r.agentId}`);
    }
  }
}

// 5. Summary
console.log('\n─────────────────────────────');
console.log(`Summary: ${errors} errors, ${warnings} warnings`);
if (errors === 0 && warnings === 0) {
  console.log('✅ Iron Theme Validator: 全 PASS（雙向一致 + schema 完整）');
}
console.log('─────────────────────────────');
process.exit(errors > 0 ? 2 : warnings > 0 ? 1 : 0);
