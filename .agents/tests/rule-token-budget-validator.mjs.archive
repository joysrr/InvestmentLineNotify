#!/usr/bin/env node
// rule-token-budget-validator.mjs
// 偵測 rules/*.md 是否超過 token 預算門檻
// 依 PROPOSAL_20260424_020 Phase F；PROPOSAL_20260501_003 + ADR-0038 升級為 tier-based
//
// 估算公式：chars / 3.5（中英混合，與 lead.md §s_complexity_lane 一致）
//
// Tier-based budget（ADR-0038）：
//   meta:         warn=500   block=1000   (file_type=always_on)
//   worker:       warn=1500  block=2500   (rule_category=worker)
//   orchestrator: warn=1800  block=3000   (rule_category=orchestrator)
//
// 使用：node .agents/tests/rule-token-budget-validator.mjs [--verbose]
//
// 退出碼：
//   0 = 全部通過（所有 rules ≤ warn）
//   1 = warning（任一 rule 超 warn；不阻斷 commit）
//   2 = error（任一 rule 超 block；阻斷 commit）

import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseFrontmatter } from './lib/frontmatter.mjs';

const __dirname = dirname(fileURLToPath(import.meta.url));
const AGENTS_ROOT = join(__dirname, '..');
const RULES_DIR = join(AGENTS_ROOT, 'rules');
const IRON_RULES_DIR = join(AGENTS_ROOT, 'iron-rules');  // PROPOSAL_004 W-7
const THRESHOLDS_PATH = join(AGENTS_ROOT, 'SYSTEM_THRESHOLDS.yaml');
const KNOWN_ISSUES_PATH = join(AGENTS_ROOT, 'KNOWN_ISSUES.md');  // PROPOSAL_502_009 I-2

// ---- KI-001 allowlist 解析（PROPOSAL_502_009 I-2）----
// 從 KNOWN_ISSUES.md 解析 KI-001 條目對應的檔案路徑（相對 .agents/）
// 不存在 / 解析失敗 → fallback 為硬編碼預設（向後相容）
function loadKIAllowlist() {
  const fallback = ['iron-rules/data-deletion-zero-tolerance.md'];
  if (!existsSync(KNOWN_ISSUES_PATH)) return fallback;
  const text = readFileSync(KNOWN_ISSUES_PATH, 'utf-8');
  // 尋找 KI-001 行（| KI-001 | ... | ... |），提取 backtick 包覆的檔案路徑
  const ki001Line = text.split('\n').find(l => /^\|\s*KI-001\s*\|/.test(l));
  if (!ki001Line) return fallback;
  const m = ki001Line.match(/`([^`]+\.md)`/);
  return m ? [m[1]] : fallback;
}

const verbose = process.argv.includes('--verbose');

// ---- Token 估算（ADR-0038：與 schema-validator 統一；單一 SoT）----
// 公式：bytes * 0.6 / 4（中英混合估算；對齊 schema-validator）
function estimateTokens(text) {
  const bytes = Buffer.byteLength(text, 'utf-8');
  return Math.round(bytes * 0.6 / 4);
}

// ---- ADR-0038 Tier-based budget table（rule_category → warn/block）----
// + iron_theme budget（PROPOSAL_004 W-7 補強；對齊 iron-rules/README budget 標榜）
const TIER_BUDGETS = {
  meta:                 { warn: 500,  block: 1000 },
  worker:               { warn: 1500, block: 2500 },
  orchestrator:         { warn: 1800, block: 3000 },
  central_orchestrator: { warn: 2500, block: 3500 },  // PROPOSAL_502_011；lead.md only（User-facing entry; 聚合 ≥ 3 orchestrator iron-laws）
  iron_theme:           { warn: 600,  block: 1000 },  // 跨切鐵律典型 size（PROPOSAL_004 校準至實際密度）
};

// ---- 解析 SYSTEM_THRESHOLDS.yaml 取 rule_token_thresholds（fallback 用）----
function loadThresholds() {
  if (!existsSync(THRESHOLDS_PATH)) {
    return { warn: 3000, block: 4000, target_max: 4000, exempt_files: [] };  // fallback
  }
  const text = readFileSync(THRESHOLDS_PATH, 'utf-8');
  const block = text.match(/rule_token_thresholds:\s*\n((?:\s+.+\n?)+)/);
  if (!block) {
    return { warn: 3000, block: 4000, target_max: 4000, exempt_files: [] };
  }
  const cfg = { warn: 3000, block: 4000, target_max: 4000, exempt_files: [] };
  let inExemptList = false;
  for (const line of block[1].split('\n')) {
    // block-style list item under exempt_files:
    const listItem = line.match(/^\s+-\s*(.+?)\s*(?:#.*)?$/);
    if (inExemptList && listItem) {
      cfg.exempt_files.push(listItem[1].trim());
      continue;
    }
    const m = line.trim().match(/^(\w+):\s*(.*?)\s*(#.*)?$/);
    if (!m) continue;
    const [, key, val] = m;
    inExemptList = false;
    if (key === 'warn' || key === 'block' || key === 'target_max') {
      cfg[key] = parseInt(val, 10);
    } else if (key === 'exempt_files') {
      if (val && val.startsWith('[')) {
        // inline list [a, b]
        cfg.exempt_files = val.replace(/[\[\]]/g, '').split(',').map(s => s.trim()).filter(Boolean);
      } else {
        // block-style 接續讀後續 - item 行
        inExemptList = true;
      }
    }
  }
  return cfg;
}

// ---- Main ----
function main() {
  console.log('🔍 Running rule-token-budget-validator (ADR-0038 tier-based)');

  if (!existsSync(RULES_DIR)) {
    console.error(`❌ rules/ 目錄不存在：${RULES_DIR}`);
    process.exit(2);
  }

  const cfgFallback = loadThresholds();  // exempt_files 仍由 SYSTEM_THRESHOLDS 驅動
  if (verbose) console.log(`ℹ️  ADR-0038 tier budgets: meta=500/1000  worker=1500/2500  orchestrator=1800/3000  iron_theme=300/500`);

  // KI-001 allowlist（PROPOSAL_502_009 I-2）：已知接受的 token warning 不計入 warnings 總數
  // 從 KNOWN_ISSUES.md 解析；fallback 為硬編碼 KI-001 對應檔案
  const kiAllowlist = loadKIAllowlist();
  if (verbose && kiAllowlist.length > 0) {
    console.log(`ℹ️  KI allowlist: ${kiAllowlist.join(', ')}`);
  }

  // 掃 rules/ + iron-rules/（PROPOSAL_004 W-7）
  const rules = readdirSync(RULES_DIR).filter(f => f.endsWith('.md'));
  const ironThemes = existsSync(IRON_RULES_DIR)
    ? readdirSync(IRON_RULES_DIR).filter(f => f.endsWith('.md') && f !== 'README.md')
    : [];
  let errors = 0, warnings = 0, total = 0;
  const results = [];

  // 內部 helper：依 dir + tier 字串驗單檔
  const checkFile = (dir, f, tierOverride = null) => {
    if (cfgFallback.exempt_files.includes(f)) {
      if (verbose) console.log(`ℹ️  (exempt) ${f}`);
      return;
    }
    const text = readFileSync(join(dir, f), 'utf-8');
    const fm = parseFrontmatter(text) || {};
    const cat = tierOverride || fm.rule_category;
    if (!cat) {
      console.error(`❌ ${f}: 缺 rule_category 欄位（ADR-0038 必填）`);
      errors++;
      return;
    }
    const budget = TIER_BUDGETS[cat];
    if (!budget) {
      console.error(`❌ ${f}: rule_category="${cat}" 不合法（合法：meta/worker/orchestrator/iron_theme）`);
      errors++;
      return;
    }
    const tokens = estimateTokens(text);
    total += tokens;
    let status = '✅';
    const relPath = `${dir.split('/').pop()}/${f}`;
    const isKI = kiAllowlist.includes(relPath);
    if (tokens > budget.block) {
      console.error(`❌ [BLOCK] ${relPath}: ${tokens} tokens > ${cat} block ${budget.block} → 必先立案拆檔（rule_edit_critical）`);
      errors++;
      status = '🔴';
    } else if (tokens > budget.warn) {
      if (isKI) {
        // KI-001 已知接受的 warning：顯示但不計入 warnings 總數（PROPOSAL_502_009 I-2）
        console.log(`ℹ️  [KI] ${relPath}: ${tokens} tokens > ${cat} warn ${budget.warn}（已知接受；KNOWN_ISSUES.md 追蹤）`);
        status = '🟢'; // KI-known
      } else {
        console.warn(`⚠️  [WARN]  ${relPath}: ${tokens} tokens > ${cat} warn ${budget.warn} → 建議立案拆檔（rule_edit_large）`);
        warnings++;
        status = '🟡';
      }
    } else if (verbose) {
      console.log(`ℹ️  ${f} (${cat}): ${tokens}/${budget.warn} tokens ✅`);
    }
    results.push({ file: f, tokens, status, cat });
  };

  // 1. 掃 rules/（依 frontmatter rule_category）
  for (const f of rules) checkFile(RULES_DIR, f);
  // 2. 掃 iron-rules/（強制 tier=iron_theme；不需 rule_category 欄位）
  for (const f of ironThemes) checkFile(IRON_RULES_DIR, f, 'iron_theme');

  // 摘要
  console.log('');
  console.log(`Summary: ${rules.length} rules + ${ironThemes.length} iron-themes; total ~${total} tokens; errors=${errors}, warnings=${warnings}`);
  if (verbose || errors + warnings > 0) {
    console.log('');
    console.log('Top 5 largest:');
    results.sort((a, b) => b.tokens - a.tokens).slice(0, 5).forEach(r =>
      console.log(`  ${r.status} ${r.file} (${r.cat}): ${r.tokens} tokens`)
    );
  }

  if (errors > 0) process.exit(2);
  if (warnings > 0) process.exit(1);
  process.exit(0);
}

main();
