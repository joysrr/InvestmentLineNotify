#!/usr/bin/env node
// cross-harness-validator.mjs
// PROPOSAL_502_021 Sprint C-4：cross-harness 部署健康度驗證
//
// 用途：在任一 harness 部署 framework 後跑此 script，產生「實測達成率」報告。
//   每個 harness 跑一次；輸出累積到 .agents/docs/Reports/CROSS_HARNESS_RESULTS.json。
//
// 使用：
//   node .agents/scripts/cross-harness-validator.mjs                   # 跑當前環境完整檢測
//   node .agents/scripts/cross-harness-validator.mjs --append          # append 至 results.json（多 harness 累積）
//   node .agents/scripts/cross-harness-validator.mjs --report          # 產 markdown 摘要

import { execSync } from 'node:child_process';
import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = join(__dirname, '..', '..');
const RESULTS_PATH = join(REPO_ROOT, '.agents', 'docs', 'Reports', 'CROSS_HARNESS_RESULTS.json');
const REPORT_PATH = join(REPO_ROOT, '.agents', 'docs', 'Reports', 'CROSS_HARNESS_REPORT.md');

const args = process.argv.slice(2);
const appendMode = args.includes('--append');
const wantReport = args.includes('--report');

function runJSON(cmd) {
  try {
    const out = execSync(cmd, { cwd: REPO_ROOT, encoding: 'utf-8', timeout: 60_000 });
    return JSON.parse(out);
  } catch (e) {
    return { error: e.message };
  }
}

function runText(cmd) {
  try {
    return execSync(cmd, { cwd: REPO_ROOT, encoding: 'utf-8', timeout: 120_000 });
  } catch (e) {
    return { stdout: e.stdout?.toString() || '', stderr: e.stderr?.toString() || '', code: e.status };
  }
}

function computeDoD(res) {
  const dod = {
    drift_pass: res.drift_score != null && res.drift_score >= 0.85,
    validators_pass: res.validator_errors === 0,
    mempalace_functional: res.platform?.capabilities?.mempalace_mcp || res.platform?.capabilities?.mempalace_cli,
    harness_detected: res.platform?.harness && res.platform.harness !== 'unknown',
    fs_writable: res.platform?.capabilities?.fs_writable === true,
  };
  const passed = Object.values(dod).filter(Boolean).length;
  const total = Object.keys(dod).length;
  return { dod, score: `${passed}/${total}`, pct: Math.round(passed / total * 100) };
}

console.log('🔍 Cross-Harness Validator (PROPOSAL_502_021 Sprint C-4)');
console.log('');

// 1. Platform detect
console.log('[1/3] Running platform-detect...');
const platform = runJSON('node .agents/scripts/platform-detect.mjs --json');

// 2. Drift simulator
console.log('[2/3] Running drift simulator (50 steps; static)...');
const driftOut = runText('node .agents/tests/agent-drift-simulator.mjs');
const driftMatch = (typeof driftOut === 'string' ? driftOut : '').match(/drift_score = ([\d.]+)/);
const driftScore = driftMatch ? parseFloat(driftMatch[1]) : null;

// 3. Validators
console.log('[3/3] Running 16 validators...');
const valOut = runText('bash .agents/tests/run-all.sh');
const valText = typeof valOut === 'string' ? valOut : (valOut.stdout || '');
const validatorErrorsMatch = valText.match(/All validation passed/);
const validatorWarningsMatch = valText.match(/has warnings/);
const validatorErrors = validatorErrorsMatch ? 0 : (valText.match(/❌|errors=([1-9])/) ? 1 : 0);

const result = {
  timestamp: new Date().toISOString(),
  framework_version: platform?.framework_version || 'unknown',
  harness: platform?.harness || 'unknown',
  confidence: platform?.confidence || 'unknown',
  platform,
  drift_score: driftScore,
  drift_passed: driftScore != null && driftScore >= 0.85,
  validator_errors: validatorErrors,
  validator_has_warnings: !!validatorWarningsMatch,
};
result.dod = computeDoD(result);

console.log('');
console.log('─────────────────────────────');
console.log('Result:');
console.log(`  harness:           ${result.harness} (${result.confidence})`);
console.log(`  drift_score:       ${result.drift_score} ${result.drift_passed ? '✅' : '❌'}`);
console.log(`  validators:        errors=${result.validator_errors}${result.validator_has_warnings ? ' (with warnings)' : ''}`);
console.log(`  DoD:               ${result.dod.score} (${result.dod.pct}%)`);
console.log(`  framework:         ${result.framework_version}`);
console.log('─────────────────────────────');

// 累積結果
mkdirSync(dirname(RESULTS_PATH), { recursive: true });
let results = [];
if (appendMode && existsSync(RESULTS_PATH)) {
  try { results = JSON.parse(readFileSync(RESULTS_PATH, 'utf-8')); } catch { results = []; }
  if (!Array.isArray(results)) results = [];
}
results.push(result);
writeFileSync(RESULTS_PATH, JSON.stringify(results, null, 2), 'utf-8');
console.log(`\n📄 Results: ${RESULTS_PATH} (${results.length} run(s))`);

if (wantReport) {
  const md = [];
  md.push('# Cross-Harness Validation Report (PROPOSAL_502_021 Sprint C)');
  md.push('');
  md.push(`Generated: ${new Date().toISOString()}`);
  md.push('');
  md.push('## Summary');
  md.push('');
  md.push('| Run | Timestamp | Harness | Confidence | drift_score | DoD | Validators |');
  md.push('|-----|-----------|---------|-----------|-------------|-----|-----------|');
  results.forEach((r, idx) => {
    md.push(`| ${idx + 1} | ${r.timestamp.slice(0, 16)}Z | ${r.harness} | ${r.confidence} | ${r.drift_score ?? 'N/A'} ${r.drift_passed ? '✅' : '❌'} | ${r.dod.score} (${r.dod.pct}%) | errors=${r.validator_errors}${r.validator_has_warnings ? ' (warn)' : ''} |`);
  });
  md.push('');
  md.push('## Detailed runs');
  md.push('');
  results.forEach((r, idx) => {
    md.push(`### Run ${idx + 1}：${r.harness}`);
    md.push('');
    md.push(`- Timestamp: ${r.timestamp}`);
    md.push(`- framework_version: ${r.framework_version}`);
    md.push(`- harness: ${r.harness} (${r.confidence})`);
    md.push(`- drift_score: ${r.drift_score} ${r.drift_passed ? '✅ ≥ 0.85' : '❌ < 0.85'}`);
    md.push(`- validators: errors=${r.validator_errors}; warnings=${r.validator_has_warnings ? 'yes' : 'no'}`);
    md.push(`- DoD: ${r.dod.score}`);
    Object.entries(r.dod.dod).forEach(([k, v]) => md.push(`  - ${k}: ${v ? '✅' : '❌'}`));
    if (r.platform?.warnings?.length) {
      md.push(`- platform warnings:`);
      r.platform.warnings.forEach(w => md.push(`  - ${w}`));
    }
    md.push('');
  });
  writeFileSync(REPORT_PATH, md.join('\n'), 'utf-8');
  console.log(`📄 Report: ${REPORT_PATH}`);
}
