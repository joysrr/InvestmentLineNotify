#!/usr/bin/env node
// tool-name-neutralizer.mjs
// PROPOSAL_502_021 Sprint B-1：盤點 / 改寫 framework 文件中 hardcoded 工具名。
//
// 目標：找出「Read tool / Bash tool / ...」等 Claude Code-specific 工具名引用，
//   分類為「應改為中性語」vs「保留（範例 / 對照表 / 設定檔）」。
//
// 使用：
//   node .agents/scripts/tool-name-neutralizer.mjs --dry-run        # 列出所有 hits 不改檔
//   node .agents/scripts/tool-name-neutralizer.mjs --report          # 輸出 markdown 報告
//   node .agents/scripts/tool-name-neutralizer.mjs --apply           # 套用改寫（自動可改部分）
//
// **預設 dry-run**；--apply 才真改檔；--report 產 .agents/docs/Reports/TOOL_NAME_NEUTRALIZATION_REPORT.md

import { readdirSync, readFileSync, writeFileSync, statSync, mkdirSync, existsSync } from 'node:fs';
import { join, relative, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = join(__dirname, '..', '..');
const AGENTS_ROOT = join(REPO_ROOT, '.agents');
const REPORT_PATH = join(AGENTS_ROOT, 'docs', 'Reports', 'TOOL_NAME_NEUTRALIZATION_REPORT.md');

const args = process.argv.slice(2);
const dryRun = !args.includes('--apply');
const wantReport = args.includes('--report');
const verbose = args.includes('--verbose');

// 工具名 → 中性語對照（依 INSTALL_ANTIGRAVITY.md §三 對照表）
// 規則：只在「規範性敘述」改寫；範例 code / 對照表 / 設定檔保留
const NEUTRAL_MAP = [
  { claude: /\bRead tool\b/g,     neutral: '讀檔工具',     desc: 'Read → view_file (Antigravity)' },
  { claude: /\bWrite tool\b/g,    neutral: '寫檔工具',     desc: 'Write → write_to_file' },
  { claude: /\bEdit tool\b/g,     neutral: '改檔工具',     desc: 'Edit → replace_file_content' },
  { claude: /\bBash tool\b/g,     neutral: '執行命令工具', desc: 'Bash → run_command' },
  { claude: /\bLS tool\b/g,       neutral: '列目錄工具',   desc: 'LS → list_dir' },
  { claude: /\bGrep tool\b/g,     neutral: '搜尋工具',     desc: 'Grep → grep_search' },
  { claude: /\bGlob tool\b/g,     neutral: '檔案 glob 工具', desc: 'Glob → file pattern matcher' },
  { claude: /\bWebFetch tool\b/g, neutral: '網頁抓取工具', desc: 'WebFetch → read_url_content' },
  { claude: /\bWebSearch tool\b/g, neutral: '網路搜尋工具', desc: 'WebSearch → search_web' },
  { claude: /\bTodoWrite tool\b/g, neutral: 'Todo 管理工具', desc: 'TodoWrite (Claude Code only)' },
  { claude: /\bTask tool\b/g,     neutral: 'sub-agent 派遣工具', desc: 'Task → harness-specific (parallel mode)' },
];

// 例外：以下檔案/目錄保留 hardcoded（範例 / 對照表 / 設定檔）
const ALLOWLIST_FILES = [
  'INSTALL_ANTIGRAVITY.md',                  // 對照表本身
  'docs/PLATFORM_COMPATIBILITY.md',          // 限制揭露
  'tasks/harness-adapter-pattern.md',        // adapter 設計
  'INSTALL.md',                              // 主部署手冊（提及工具名為合理）
  'scripts/tool-name-neutralizer.mjs',       // 本檔
  'scripts/platform-detect.mjs',             // 偵測檔
  'tests/sub-agent-dispatch-validator.mjs',  // validator
];
const ALLOWLIST_DIRS = [
  'proposals/',                              // 歷史紀錄
  'decisions/',                              // ADR 含工具名為歷史脈絡
  'memory/.export/',                         // cold backup
  'docs/Reports/',                           // 歷史 audit log
];

function* walk(dir) {
  for (const entry of readdirSync(dir)) {
    if (entry.startsWith('.') && entry !== '.agents') continue;
    if (entry === 'node_modules' || entry === '.git') continue;
    const full = join(dir, entry);
    const st = statSync(full);
    if (st.isDirectory()) yield* walk(full);
    else if (entry.endsWith('.md')) yield full;
  }
}

function isAllowlisted(rel) {
  if (ALLOWLIST_FILES.includes(rel)) return true;
  return ALLOWLIST_DIRS.some(p => rel.startsWith(p));
}

const stats = {
  filesScanned: 0,
  filesAllowlisted: 0,
  filesWithHits: 0,
  totalHits: 0,
  byTool: {},
  filesChanged: 0,
};

const reportEntries = [];

for (const file of walk(AGENTS_ROOT)) {
  stats.filesScanned++;
  const rel = relative(AGENTS_ROOT, file);
  if (isAllowlisted(rel)) { stats.filesAllowlisted++; continue; }

  const content = readFileSync(file, 'utf-8');
  let newContent = content;
  const fileHits = [];

  for (const { claude, neutral, desc } of NEUTRAL_MAP) {
    const matches = [...content.matchAll(claude)];
    if (matches.length) {
      stats.byTool[desc] = (stats.byTool[desc] || 0) + matches.length;
      stats.totalHits += matches.length;
      fileHits.push({ tool: desc, count: matches.length, sample: matches[0][0] });
      if (!dryRun) newContent = newContent.replace(claude, neutral);
    }
  }

  if (fileHits.length) {
    stats.filesWithHits++;
    reportEntries.push({ file: rel, hits: fileHits });
    if (verbose) {
      console.log(`[hit] ${rel}`);
      fileHits.forEach(h => console.log(`  ${h.tool}: ${h.count} (sample: "${h.sample}")`));
    }
    if (!dryRun && newContent !== content) {
      writeFileSync(file, newContent, 'utf-8');
      stats.filesChanged++;
    }
  }
}

console.log('🔍 Tool-name Neutralizer (PROPOSAL_502_021 Sprint B-1)');
console.log(`Mode: ${dryRun ? 'DRY-RUN' : 'APPLY'}`);
console.log('');
console.log(`Scanned:      ${stats.filesScanned} files`);
console.log(`Allowlisted:  ${stats.filesAllowlisted} files`);
console.log(`With hits:    ${stats.filesWithHits} files`);
console.log(`Total hits:   ${stats.totalHits}`);
if (!dryRun) console.log(`Files changed: ${stats.filesChanged}`);
console.log('');
console.log('By tool:');
Object.entries(stats.byTool).sort((a, b) => b[1] - a[1]).forEach(([tool, count]) => {
  console.log(`  ${count.toString().padStart(3)}  ${tool}`);
});

if (wantReport) {
  mkdirSync(dirname(REPORT_PATH), { recursive: true });
  const md = [];
  md.push('# Tool Name Neutralization Report (PROPOSAL_502_021 Sprint B-1)');
  md.push('');
  md.push(`Generated: ${new Date().toISOString()}`);
  md.push(`Mode: ${dryRun ? 'DRY-RUN' : 'APPLY'}`);
  md.push('');
  md.push('## Summary');
  md.push('');
  md.push(`- Scanned: ${stats.filesScanned} files`);
  md.push(`- Allowlisted: ${stats.filesAllowlisted} files`);
  md.push(`- With hits: ${stats.filesWithHits} files`);
  md.push(`- Total hits: ${stats.totalHits}`);
  md.push('');
  md.push('## By tool');
  md.push('');
  md.push('| Tool | Count |');
  md.push('|------|-------|');
  Object.entries(stats.byTool).sort((a, b) => b[1] - a[1]).forEach(([tool, count]) => {
    md.push(`| ${tool} | ${count} |`);
  });
  md.push('');
  md.push('## File details');
  md.push('');
  reportEntries.forEach(({ file, hits }) => {
    md.push(`### ${file}`);
    md.push('');
    hits.forEach(h => md.push(`- ${h.tool}: ${h.count} (sample: \`${h.sample}\`)`));
    md.push('');
  });
  writeFileSync(REPORT_PATH, md.join('\n'), 'utf-8');
  console.log('');
  console.log(`📄 Report: ${REPORT_PATH}`);
}

if (dryRun) {
  console.log('');
  console.log('（DRY-RUN；無實際改動。要套用：--apply；要產報告：--report）');
}
