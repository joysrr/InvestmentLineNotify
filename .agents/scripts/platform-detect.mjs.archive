#!/usr/bin/env node
// platform-detect.mjs
// 自動偵測當前 agent harness + capability 旗標
// 由 PROPOSAL_502_019 T-3 建立。
//
// 使用：
//   node .agents/scripts/platform-detect.mjs              # 標準輸出
//   node .agents/scripts/platform-detect.mjs --json       # 純 JSON 給 script 消費
//   node .agents/scripts/platform-detect.mjs --verbose    # 詳細偵測過程
//
// 輸出（JSON 或文字格式）：
//   harness: 'claude_code_cli' | 'claude_code_web' | 'antigravity' | 'qwen_agent' | 'unknown'
//   capabilities: { ... 12 維度旗標 ... }
//   fallbacks: 自動建議的降級策略
//   warnings: 限制提示

import { readFileSync, existsSync, writeFileSync, unlinkSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { execSync } from 'node:child_process';

const __dirname = dirname(fileURLToPath(import.meta.url));
const AGENTS_ROOT = join(__dirname, '..');
const PROJECT_ROOT = join(AGENTS_ROOT, '..');

const verbose = process.argv.includes('--verbose');
const jsonOnly = process.argv.includes('--json');

const vlog = (msg) => { if (verbose) console.error(`[detect] ${msg}`); };

// ──────────────── 偵測 ────────────────

function safeWhich(cmd) {
  try {
    return execSync(`which ${cmd} 2>/dev/null`, { encoding: 'utf-8' }).trim();
  } catch {
    return null;
  }
}

function safeRun(cmd) {
  try {
    return execSync(cmd, { encoding: 'utf-8', stdio: 'pipe', timeout: 3000 }).trim();
  } catch {
    return null;
  }
}

// ──────────────── Capability 偵測 ────────────────

const cap = {};

// runtime
cap.node_version = safeRun('node --version');
cap.bash_available = !!safeWhich('bash');
cap.python3_available = !!safeWhich('python3');
cap.git_available = !!safeWhich('git');

// MemPalace
cap.mempalace_cli = !!safeWhich('mempalace');
cap.mempalace_mcp = !!safeWhich('mempalace-mcp');
cap.mempalace_status_ok = false;
cap.mempalace_status_via = null;  // 'cli' | 'mcp' | null
if (cap.mempalace_cli) {
  const status = safeRun('mempalace status 2>&1');
  if (status && status.includes('drawers')) {
    cap.mempalace_status_ok = true;
    cap.mempalace_status_via = 'cli';
  }
}
// PROPOSAL_502_019 R-1（Antigravity 實機回報）：CLI 不通時 MCP 仍可能可用
// 偵測 MCP 可用性：檢查 mempalace-mcp 命令存在 + 一個輕量 RPC（暫無；fallback 給訊息）
// 注意：本 script 為 Node 純檢查；不直呼 MCP RPC（避免 STDIN 互動）。CLI 不通不代表 MCP 不通。
if (!cap.mempalace_status_ok && cap.mempalace_mcp) {
  cap.mempalace_status_via = 'mcp_assumed_available';  // mcp 命令存在；實際可達需 IDE/agent 證實
}

// MCP / Claude Code 設定
cap.mcp_json_exists = existsSync(join(PROJECT_ROOT, '.mcp.json'));
cap.claude_settings_exists = existsSync(join(PROJECT_ROOT, '.claude', 'settings.local.json'));

// PROPOSAL_502_019 R-1：Antigravity 偵測訊號
// IDE 工具命名（view_file / run_command 等）只在 LLM 對話可見，shell env 通常無；
// 但 Antigravity 可能設特定 env vars 或 process.env.WINDSURF_* / process.env.ANTIGRAVITY_*
cap.env_antigravity = !!(process.env.ANTIGRAVITY || process.env.WINDSURF_USER ||
                         process.env.CASCADE_SESSION_ID);
cap.env_qwen_agent = !!(process.env.DASHSCOPE_API_KEY || process.env.QWEN_AGENT);

// Framework files
cap.agents_dir_exists = existsSync(AGENTS_ROOT);
cap.current_workspace_set = existsSync(join(AGENTS_ROOT, 'CURRENT_WORKSPACE'));
cap.pending_actions_exists = existsSync(join(PROJECT_ROOT, 'PENDING_ACTIONS.md'));
cap.routing_ticket_exists = existsSync(join(PROJECT_ROOT, 'ROUTING_TICKET.md'));

// Env signals（heuristic）
cap.env_anthropic_key = !!process.env.ANTHROPIC_API_KEY;
cap.env_claude_code = !!process.env.CLAUDE_CODE;
cap.env_in_container = existsSync('/.dockerenv') || existsSync('/run/.containerenv');

// File system 持久性 hint（PROPOSAL_502_019 R-1：修偵測；之前用 require() 在 mjs 環境失敗）
cap.fs_writable = (() => {
  try {
    const testPath = join(PROJECT_ROOT, '.platform-detect-test');
    writeFileSync(testPath, 'test');
    unlinkSync(testPath);
    return true;
  } catch {
    return false;
  }
})();

// ──────────────── Harness 推斷 ────────────────

function inferHarness() {
  // 優先順序：明確訊號 > 環境推論 > unknown

  // 1. CLAUDE_CODE 環境變數明確 = CLI
  if (cap.env_claude_code === true) {
    return { harness: 'claude_code_cli', confidence: 'high' };
  }

  // 2. PROPOSAL_502_019 R-1：Antigravity env signals 明確
  if (cap.env_antigravity) {
    return { harness: 'antigravity', confidence: 'high' };
  }

  // 3. PROPOSAL_502_019 R-1：Qwen-Agent env signals
  if (cap.env_qwen_agent) {
    return { harness: 'qwen_agent', confidence: 'high' };
  }

  // 4. ANTHROPIC_API_KEY + 在 container = web 高機率
  if (cap.env_anthropic_key && cap.env_in_container) {
    return { harness: 'claude_code_web', confidence: 'medium' };
  }

  // 5. 純 ANTHROPIC_API_KEY = CLI 高機率
  if (cap.env_anthropic_key && !cap.env_in_container) {
    return { harness: 'claude_code_cli', confidence: 'medium' };
  }

  // 6. .mcp.json + .claude/ 存在 = Claude Code（CLI 或 Web）
  if (cap.mcp_json_exists && cap.claude_settings_exists) {
    return { harness: 'claude_code_cli', confidence: 'medium' };
  }

  // 7. 只有 .mcp.json 沒 .claude/ → 可能 Antigravity 或自建
  if (cap.mcp_json_exists && !cap.claude_settings_exists) {
    return { harness: 'antigravity_or_custom', confidence: 'low' };
  }

  // 8. mempalace 全 OK 但 .mcp.json / .claude 都無 → Antigravity 自有 MCP 註冊或 Qwen-Agent
  if (cap.mempalace_cli && cap.mempalace_mcp && !cap.mcp_json_exists && !cap.claude_settings_exists) {
    return { harness: 'antigravity_or_custom', confidence: 'medium' };
  }

  // 9. 沒任何明確訊號
  return { harness: 'unknown', confidence: 'low' };
}

// ──────────────── Fallback / Warnings ────────────────

function computeFallbacks(harness, c) {
  const fallbacks = [];

  if (!c.mempalace_cli) {
    fallbacks.push('mempalace 套件不可達 → 純 markdown grep filesystem fallback（hybrid mode；ADR-0039）');
  }

  if (!c.mempalace_mcp) {
    fallbacks.push('mempalace-mcp 不可達 → 改用 mempalace CLI 直呼（不依 MCP）');
  }

  if (!c.mcp_json_exists && c.mempalace_cli) {
    fallbacks.push('.mcp.json 不存在 → 跳過 MCP server 註冊；走 CLI 路徑');
  }

  if (!c.claude_settings_exists && harness !== 'claude_code_cli') {
    fallbacks.push('.claude/settings.local.json 不存在或非 Claude Code → 手動 trigger auto-mine（commit 後派 @Assistant 巡邏 + 手動 mempalace mine）');
  }

  if (!c.fs_writable) {
    fallbacks.push('專案根不可寫 → PENDING_ACTIONS / ROUTING_TICKET 無法持久；考慮改寫 .agents/state/');
  }

  return fallbacks;
}

function computeWarnings(harness, c) {
  const w = [];

  if (harness === 'unknown') {
    w.push('未能明確判定 harness；建議手動讀 docs/PLATFORM_COMPATIBILITY.md 對照支援度');
  }

  if (harness === 'antigravity_or_custom') {
    w.push('推論為 Antigravity / 自建環境；尚未驗證；建議先做 hello-world dispatch + 重測 drift baseline');
  }

  if (!c.python3_available) {
    w.push('Python 3 不可達 → mempalace 安裝失敗；framework runtime requirement 違反（FRAMEWORK_REQUIREMENTS §1）');
  }

  if (c.mempalace_cli && !c.mempalace_status_ok) {
    w.push('mempalace 套件存在但 status 失敗 → palace 可能未 init；先跑 `mempalace init`');
  }

  if (c.agents_dir_exists && !c.current_workspace_set) {
    w.push('framework 已部署但 CURRENT_WORKSPACE 未設定 → 先跑 `node .agents/scripts/init-workspace.mjs`');
  }

  return w;
}

// ──────────────── Output ────────────────

const inferred = inferHarness();
const fallbacks = computeFallbacks(inferred.harness, cap);
const warnings = computeWarnings(inferred.harness, cap);

const result = {
  harness: inferred.harness,
  confidence: inferred.confidence,
  capabilities: cap,
  fallbacks,
  warnings,
  framework_version: (() => {
    try {
      const v = readFileSync(join(AGENTS_ROOT, 'FRAMEWORK_VERSION'), 'utf-8');
      const m = v.match(/framework_version:\s*(v\S+)/);
      return m ? m[1] : 'unknown';
    } catch { return 'unknown'; }
  })(),
  detected_at: new Date().toISOString(),
};

if (jsonOnly) {
  console.log(JSON.stringify(result, null, 2));
  process.exit(0);
}

// 文字格式輸出
console.log('🔍 Platform Detection Report');
console.log('───────────────────────────────────');
console.log(`Harness:           ${result.harness} (${result.confidence} confidence)`);
console.log(`Framework:         ${result.framework_version}`);
console.log(`Detected at:       ${result.detected_at}`);
console.log('');
console.log('Runtime capabilities:');
console.log(`  Node:            ${cap.node_version || '❌ missing'}`);
console.log(`  Bash:            ${cap.bash_available ? '✅' : '❌'}`);
console.log(`  Python3:         ${cap.python3_available ? '✅' : '❌'}`);
console.log(`  Git:             ${cap.git_available ? '✅' : '❌'}`);
console.log('');
console.log('MemPalace:');
console.log(`  CLI:             ${cap.mempalace_cli ? '✅' : '❌'}`);
console.log(`  MCP server:      ${cap.mempalace_mcp ? '✅' : '❌'}`);
console.log(`  Status OK:       ${cap.mempalace_status_ok ? '✅' : '❌'}`);
console.log('');
console.log('Framework state:');
console.log(`  .agents/:        ${cap.agents_dir_exists ? '✅' : '❌'}`);
console.log(`  .mcp.json:       ${cap.mcp_json_exists ? '✅' : '⚠️ '}`);
console.log(`  .claude/local:   ${cap.claude_settings_exists ? '✅' : '⚠️ '}`);
console.log(`  CURRENT_WS:      ${cap.current_workspace_set ? '✅' : '⚠️  未設定'}`);
console.log(`  PENDING_ACTIONS: ${cap.pending_actions_exists ? '✅' : '⚠️  fresh init'}`);
console.log(`  ROUTING_TICKET:  ${cap.routing_ticket_exists ? '✅' : '⚠️  fresh'}`);
console.log('');

if (fallbacks.length > 0) {
  console.log('🔄 Fallbacks 自動建議：');
  fallbacks.forEach((f) => console.log(`  - ${f}`));
  console.log('');
}

if (warnings.length > 0) {
  console.log('⚠️  Warnings：');
  warnings.forEach((w) => console.log(`  - ${w}`));
  console.log('');
}

console.log('🧭 部署建議：');
const map = {
  claude_code_cli: 'INSTALL.md 直接照走 100%',
  claude_code_web: 'INSTALL.md §一~§六（§四 MCP 視 sandbox 而定）',
  antigravity: 'INSTALL_ANTIGRAVITY.md（IDE 自有 MCP 註冊；無 sub-agent 限制）',
  qwen_agent: 'INSTALL_QWEN_AGENT.md（sub-agent / dispatch adapter 必寫）',
  antigravity_or_custom: 'INSTALL.md §一~§三 + 自寫 adapter（依 tasks/harness-adapter-pattern.md）',
  unknown: '先讀 docs/PLATFORM_COMPATIBILITY.md 對照',
};
console.log(`  ${map[result.harness] || map.unknown}`);
console.log('');
console.log('完整 capability 對照：docs/PLATFORM_COMPATIBILITY.md');
console.log('Adapter 設計指南：tasks/harness-adapter-pattern.md');

// Exit code: 0=detected; 1=unknown harness; 2=critical fallback needed
process.exit(
  result.harness === 'unknown' ? 1
  : warnings.some(w => w.includes('FRAMEWORK_REQUIREMENTS 違反')) ? 2
  : 0
);
