#!/usr/bin/env node
// mempalace-export.mjs
// 透過 MCP stdio JSON-RPC 協定 dump 所有 drawer 至 markdown 作為 cold backup。
// 由 PROPOSAL_502_020 T-1 建立（Plan G）。
//
// 設計理由：
//   mempalace 3.3.4 CLI 無 native export；唯一 export 路徑是透過 MCP tools
//   (mempalace_list_drawers + mempalace_get_drawer) 組合。
//   本 script 對齊 ADR-0039 v2 (Plan G)：mempalace 為 primary SoT；markdown 為 export artifact。
//
// 輸出：
//   .agents/memory/.export/<wing>/<room>/<drawer-id>.md
//   每個 drawer 一檔；frontmatter 含 metadata；body 含 verbatim content。
//
// 使用：
//   node .agents/scripts/mempalace-export.mjs                # export all wings/rooms
//   node .agents/scripts/mempalace-export.mjs --wing framework  # 限定 wing
//   node .agents/scripts/mempalace-export.mjs --dry-run      # 不寫檔；只列出
//   node .agents/scripts/mempalace-export.mjs --verbose      # 詳細 RPC trace

import { spawn } from 'node:child_process';
import { mkdirSync, writeFileSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const AGENTS_ROOT = join(__dirname, '..');
const EXPORT_ROOT = join(AGENTS_ROOT, 'memory', '.export');

// ───── CLI 參數 ─────
const args = process.argv.slice(2);
const verbose = args.includes('--verbose');
const dryRun = args.includes('--dry-run');
const wingFilter = (args[args.indexOf('--wing') + 1] && !args[args.indexOf('--wing') + 1].startsWith('--'))
  ? args[args.indexOf('--wing') + 1] : null;

const log = (msg) => console.log(`[export] ${msg}`);
const vlog = (msg) => verbose && console.error(`[trace] ${msg}`);
const err = (msg) => console.error(`[ERROR] ${msg}`);

// ───── MCP stdio JSON-RPC client ─────
class MCPClient {
  constructor(command, args = []) {
    this.proc = spawn(command, args, { stdio: ['pipe', 'pipe', 'inherit'] });
    this.buf = '';
    this.pending = new Map();   // id → resolve
    this.nextId = 1;
    this.proc.stdout.on('data', (chunk) => this._onData(chunk));
    this.proc.on('error', (e) => err(`MCP spawn failed: ${e.message}`));
  }

  _onData(chunk) {
    this.buf += chunk.toString('utf-8');
    let nl;
    while ((nl = this.buf.indexOf('\n')) >= 0) {
      const line = this.buf.slice(0, nl).trim();
      this.buf = this.buf.slice(nl + 1);
      if (!line || !line.startsWith('{')) continue;
      try {
        const msg = JSON.parse(line);
        vlog(`<< ${JSON.stringify(msg).slice(0, 200)}`);
        if (msg.id != null && this.pending.has(msg.id)) {
          const { resolve, reject } = this.pending.get(msg.id);
          this.pending.delete(msg.id);
          if (msg.error) reject(new Error(msg.error.message || JSON.stringify(msg.error)));
          else resolve(msg.result);
        }
      } catch (e) {
        vlog(`(skip non-JSON line) ${line.slice(0, 80)}`);
      }
    }
  }

  request(method, params = {}) {
    const id = this.nextId++;
    const req = { jsonrpc: '2.0', id, method, params };
    vlog(`>> ${method} (id=${id})`);
    this.proc.stdin.write(JSON.stringify(req) + '\n');
    return new Promise((resolve, reject) => {
      this.pending.set(id, { resolve, reject });
      setTimeout(() => {
        if (this.pending.has(id)) {
          this.pending.delete(id);
          reject(new Error(`RPC timeout: ${method}`));
        }
      }, 30000);
    });
  }

  notify(method, params = {}) {
    const req = { jsonrpc: '2.0', method, params };
    vlog(`>> ${method} (notification)`);
    this.proc.stdin.write(JSON.stringify(req) + '\n');
  }

  async callTool(name, args = {}) {
    const result = await this.request('tools/call', { name, arguments: args });
    // MCP tool result format: { content: [{type: 'text', text: '...'}], ... }
    if (result?.content?.[0]?.type === 'text') {
      const text = result.content[0].text;
      try {
        return JSON.parse(text);
      } catch {
        return text;
      }
    }
    return result;
  }

  close() {
    this.proc.stdin.end();
    this.proc.kill('SIGTERM');
  }
}

// ───── frontmatter 工具 ─────
function escapeYaml(v) {
  if (v == null) return '';
  const s = String(v);
  if (/[:#\n"']/.test(s)) return JSON.stringify(s);
  return s;
}

function drawerToMarkdown(drawer) {
  const fm = [];
  fm.push('---');
  fm.push(`drawer_id: ${escapeYaml(drawer.id || drawer.drawer_id)}`);
  fm.push(`wing: ${escapeYaml(drawer.wing)}`);
  fm.push(`room: ${escapeYaml(drawer.room)}`);
  if (drawer.source_file) fm.push(`source_file: ${escapeYaml(drawer.source_file)}`);
  if (drawer.added_by) fm.push(`added_by: ${escapeYaml(drawer.added_by)}`);
  if (drawer.created_at) fm.push(`created_at: ${escapeYaml(drawer.created_at)}`);
  fm.push(`exported_at: ${new Date().toISOString()}`);
  fm.push(`exported_by: mempalace-export.mjs (PROPOSAL_502_020 T-1)`);
  fm.push('---');
  fm.push('');
  fm.push(drawer.content || '');
  return fm.join('\n');
}

function safeFilename(s) {
  return String(s || 'unnamed').replace(/[^A-Za-z0-9_.-]/g, '_').slice(0, 120);
}

// ───── 主流程 ─────
async function main() {
  log('Starting MemPalace export via MCP RPC');
  if (dryRun) log('DRY-RUN: 不寫檔；只列出');
  if (wingFilter) log(`Wing 過濾：${wingFilter}`);

  const mcp = new MCPClient('mempalace-mcp');

  try {
    // 1. initialize
    await mcp.request('initialize', {
      protocolVersion: '2024-11-05',
      capabilities: {},
      clientInfo: { name: 'mempalace-export', version: '1.0.0' },
    });
    mcp.notify('notifications/initialized');
    vlog('MCP initialized');

    // 2. list_wings
    //    回傳格式：{wings: {wing_name: drawer_count}} 或 array 或 {items}
    const wingsResult = await mcp.callTool('mempalace_list_wings');
    let wings;
    if (Array.isArray(wingsResult)) {
      wings = wingsResult;
    } else if (wingsResult?.wings && typeof wingsResult.wings === 'object' && !Array.isArray(wingsResult.wings)) {
      wings = Object.keys(wingsResult.wings);
    } else if (Array.isArray(wingsResult?.wings)) {
      wings = wingsResult.wings;
    } else if (Array.isArray(wingsResult?.items)) {
      wings = wingsResult.items;
    } else {
      wings = [];
    }
    log(`Found ${wings.length} wing(s): ${wings.map(w => typeof w === 'string' ? w : (w.wing || w.name)).join(', ')}`);

    // 3. 遍歷每個 wing/room/drawer
    let totalExported = 0;
    let totalSkipped = 0;

    for (const wingObj of wings) {
      const wingName = typeof wingObj === 'string' ? wingObj : (wingObj.wing || wingObj.name);
      if (!wingName) continue;
      if (wingFilter && wingName !== wingFilter) {
        vlog(`Skip wing ${wingName} (filter)`);
        continue;
      }

      // list rooms in wing
      //    回傳格式：{wing, rooms: {room_name: count}} 或 array 或 {items}
      const roomsResult = await mcp.callTool('mempalace_list_rooms', { wing: wingName });
      let rooms;
      if (Array.isArray(roomsResult)) {
        rooms = roomsResult;
      } else if (roomsResult?.rooms && typeof roomsResult.rooms === 'object' && !Array.isArray(roomsResult.rooms)) {
        rooms = Object.keys(roomsResult.rooms);
      } else if (Array.isArray(roomsResult?.rooms)) {
        rooms = roomsResult.rooms;
      } else if (Array.isArray(roomsResult?.items)) {
        rooms = roomsResult.items;
      } else {
        rooms = [];
      }
      log(`Wing ${wingName}: ${rooms.length} room(s): ${rooms.map(r => typeof r === 'string' ? r : (r.room || r.name)).join(', ')}`);

      for (const roomObj of rooms) {
        const roomName = typeof roomObj === 'string' ? roomObj : (roomObj.room || roomObj.name);
        if (!roomName) continue;

        // pagination：每次 100；offset 累進
        let offset = 0;
        let roomCount = 0;
        while (true) {
          const listResult = await mcp.callTool('mempalace_list_drawers', {
            wing: wingName, room: roomName, limit: 100, offset,
          });
          const drawers = Array.isArray(listResult) ? listResult :
                          (listResult.drawers || listResult.items || []);
          if (!drawers.length) break;

          for (const meta of drawers) {
            const drawerId = meta.id || meta.drawer_id;
            if (!drawerId) continue;

            // 取完整內容
            let drawer;
            try {
              drawer = await mcp.callTool('mempalace_get_drawer', { drawer_id: drawerId });
            } catch (e) {
              err(`get_drawer ${drawerId}: ${e.message}`);
              totalSkipped++;
              continue;
            }
            if (!drawer || !drawer.content) {
              totalSkipped++;
              continue;
            }
            // ensure metadata
            drawer.id = drawerId;
            drawer.wing = drawer.wing || wingName;
            drawer.room = drawer.room || roomName;

            // 寫檔
            const outDir = join(EXPORT_ROOT, safeFilename(wingName), safeFilename(roomName));
            const outPath = join(outDir, `${safeFilename(drawerId)}.md`);
            const md = drawerToMarkdown(drawer);

            if (dryRun) {
              vlog(`would write: ${outPath} (${md.length} chars)`);
            } else {
              mkdirSync(outDir, { recursive: true });
              writeFileSync(outPath, md, 'utf-8');
              vlog(`wrote: ${outPath}`);
            }
            roomCount++;
            totalExported++;
          }

          if (drawers.length < 100) break;
          offset += drawers.length;
        }

        log(`  ${wingName}/${roomName}: ${roomCount} drawer(s)`);
      }
    }

    log('─────────────────────────────');
    log(`Exported ${totalExported} drawer(s); skipped ${totalSkipped}`);
    if (!dryRun) log(`Output: ${EXPORT_ROOT}/`);
    log('Done.');
  } finally {
    mcp.close();
  }
}

main().catch((e) => {
  err(e.stack || e.message || String(e));
  process.exit(1);
});
