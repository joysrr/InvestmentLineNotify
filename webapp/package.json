{
  "name": "investment-webapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production && node scripts/check-bundle-size.mjs",
    "build:analyze": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint . --ext .js,.mjs,.vue && node scripts/check-no-raw-color.mjs",
    "lint:colors": "node scripts/check-no-raw-color.mjs",
    "ui:pull": "git -C .. pull --ff-only origin main",
    "ui:push": "sh scripts/agent/push-git.sh",
    "ui:baseline": "sh scripts/agent/run.sh baseline",
    "ui:verify": "node scripts/agent/verify-git.mjs",
    "ui:rollback": "sh scripts/agent/run.sh rollback",
    "ui:report": "cat .agent-report/latest/REPORT.md",
    "ui:verify:pixel": "sh scripts/agent/run.sh verify"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "^5.5.1",
    "element-plus": "^2.14.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^24.1.3",
    "pino": "^9.5.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
