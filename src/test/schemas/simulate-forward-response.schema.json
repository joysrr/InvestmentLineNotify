{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investmentlinenotify/api/v1/simulate/forward-response",
  "title": "Forward Simulation Response",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "simulatedPrice0050",
    "simulatedPriceZ2",
    "priceDiffPct0050",
    "priceDiffPctZ2",
    "strategyScore",
    "strategyStatus",
    "strategyTarget",
    "strategySuggestion",
    "maintenanceMargin",
    "portfolioHealth",
    "lifecycleStage",
    "calculationMode",
    "timestamp",
    "dataAsOf",
    "assumptions",
    "warnings",
    "disclaimer",
    "currentPrice0050",
    "currentPriceZ2",
    "indicators",
    "dataQuality"
  ],
  "properties": {
    "simulatedPrice0050": { "type": "number" },
    "simulatedPriceZ2": { "type": "number" },
    "priceDiffPct0050": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
    "priceDiffPctZ2": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
    "strategyScore": { "type": "integer", "minimum": -100, "maximum": 200 },
    "strategyStatus": { "type": "string" },
    "strategyTarget": { "type": "string" },
    "strategySuggestion": { "type": "string" },
    "maintenanceMargin": { "type": "number" },
    "portfolioHealth": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "maintenanceRisk",
        "actualLeverage",
        "z2Ratio",
        "grossLeverage",
        "grossLeverageStatus",
        "decouplingAnalysis",
        "marginAnalysis"
      ],
      "properties": {
        "maintenanceRisk": { "type": "object", "additionalProperties": true },
        "actualLeverage": { "type": "number" },
        "z2Ratio": { "type": "number" },
        "grossLeverage": { "type": "number" },
        "grossLeverageStatus": {
          "type": "string",
          "enum": ["normal", "warning", "danger"]
        },
        "decouplingAnalysis": {
          "type": "object",
          "additionalProperties": true
        },
        "marginAnalysis": { "type": "object", "additionalProperties": true }
      }
    },
    "lifecycleStage": {
      "type": "string",
      "enum": ["累積期", "成長期", "成熟期", "防守期", "退休期"]
    },
    "calculationMode": { "type": "string", "const": "forward" },
    "timestamp": { "type": "string", "format": "date-time" },
    "dataAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "disclaimer": { "type": "string", "minLength": 10 },
    "currentPrice0050": { "type": "number" },
    "currentPriceZ2": { "type": "number" },
    "indicators": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rsi": { "type": "number" },
        "kd": {
          "type": "object",
          "properties": { "k": { "type": "number" }, "d": { "type": "number" } }
        },
        "macd": {
          "type": "object",
          "properties": {
            "MACD": { "type": "number" },
            "signal": { "type": "number" },
            "histogram": { "type": "number" }
          }
        },
        "ma20": { "type": ["number", "null"] },
        "ma60": { "type": ["number", "null"] },
        "ma240": { "type": ["number", "null"] },
        "bias240": { "type": ["number", "null"] },
        "atr": { "type": ["number", "null"] }
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rsi", "kd", "macd", "ma20", "ma60", "ma240", "atr"],
      "properties": {
        "rsi": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        },
        "kd": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        },
        "macd": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        },
        "ma20": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        },
        "ma60": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        },
        "ma240": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        },
        "atr": {
          "type": "string",
          "enum": ["ok", "fallback_used", "insufficient_data"]
        }
      }
    }
  }
}
