{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investmentlinenotify/api/error-response",
  "title": "Standard Error Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "message", "statusCode"],
  "properties": {
    "error": { "type": "string", "enum": ["BAD_REQUEST", "VALIDATION_ERROR", "CONFLICT", "DATA_NOT_READY", "SERVICE_UNAVAILABLE", "INTERNAL_ERROR"] },
    "message": { "type": "string", "minLength": 1 },
    "statusCode": { "type": "integer", "enum": [400, 401, 403, 409, 500, 503] },
    "field": { "type": ["string", "null"] }
  }
}