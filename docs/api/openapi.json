        }
      }
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/deploy/{jobId}": {
      "get": {
        "summary": "查詢部署任務狀態",
        "operationId": "getDeployStatus",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "部署任務狀態",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "commit": {
                      "type": "string"
                    },
                    "version": {
                      "type": "object"
                    },
                    "verification": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "任務不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/deploy/{jobId}/ws": {
      "get": {
        "summary": "WebSocket 即時日誌流",
        "operationId": "deployLogsWs",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols"
          }
        }
      }
    },
    "/api/data-evidence-report": {
      "get": {
        "description": "取得最新資料證據報告 (JSON)",
        "tags": ["data-evidence"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "description": "即時生成最新資料證據報告並寫入落地檔，同時回傳一次性下載 Ticket URL",
        "tags": ["data-evidence"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/data-evidence-report/download": {
      "get": {
        "description": "檔案下載端點 (帶 Content-Disposition: attachment)",
        "tags": ["data-evidence"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/replay-evidence": {
      "get": {
        "description": "List replay evidence files",
        "tags": ["replay"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/report/latest-theoretical": {
      "get": {
        "description": "Returns the latest report that has theoreticalShadow.status === 'AVAILABLE'",
        "tags": ["reports"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/social-sentiment": {
      "get": {
        "description": "回傳最新社群情緒快照，若檔案不存在則回傳安全預設值 (Safe-fallback)",
        "tags": ["sentiment"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
