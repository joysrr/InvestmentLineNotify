    "/api/backtest/run": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "quiet": {
                    "type": "boolean"
                  },
                  "disableGuards": {
                    "type": "boolean"
                  },
                  "buyTactical": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "buyTacticalBullish": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "disableLoanGuard": {
                    "type": "boolean"
                  },
                  "initialCash": {
                    "type": "number",
                    "minimum": 0
                  },
                  "monthlyDca": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pledgeRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "interestRate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
