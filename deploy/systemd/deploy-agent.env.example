# Copy to /etc/investnotify/deploy-agent.env on the Host.
# Replace every value with a path verified on that Host.
INVESTNOTIFY_AGENT_SOCKET=/run/investnotify/deploy-agent.sock
DEPLOY_PATH=__VERIFIED_PROJECT_ROOT__
WEBAPP_PATH=__VERIFIED_PROJECT_ROOT__/webapp
PM2_ECOSYSTEM=ecosystem.config.cjs
PRODUCTION_DATA_DIR=__VERIFIED_PROJECT_ROOT__/data
PRODUCTION_LOGS_DIR=__VERIFIED_PROJECT_ROOT__/logs
DIAGNOSTICS_DIR=__VERIFIED_EXTERNAL_DIAGNOSTICS_DIR__
