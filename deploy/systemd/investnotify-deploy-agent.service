[Unit]
Description=InvestmentLineNotify Host Deployment Agent
After=network.target

[Service]
Type=simple
User=ubuntu
Group=investnotify-deploy
UMask=0007
RuntimeDirectory=investnotify
RuntimeDirectoryMode=0770
# Replace __PROJECT_ROOT__ during Host installation with the verified repo path.
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=/etc/investnotify/deploy-agent.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node __PROJECT_ROOT__/scripts/deployment-agent.mjs
# Do not enable this template before replacing __PROJECT_ROOT__.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
